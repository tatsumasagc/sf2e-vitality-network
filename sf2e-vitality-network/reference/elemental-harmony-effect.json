{
    "name": "Elemental Harmony",
    "type": "effect",
    "img": "systems/pf2e/icons/default-icons/effect.svg",
    "system": {
        "description": {
            "value": "<p>When you Transfer Vitality, choose an elemental trait: air, earth, fire, metal, water or wood. The target's next Strike deals damage based on the chosen trait (your choice) rather than its typical damage type.</p><p>Elemental trait: <strong>Fire</strong>. Strike damage becomes <strong>fire</strong> (or whichever of fire the target chooses).</p><p>This lasts until the end of the target's next turn.</p><p><strong>Source</strong> Starfinder Player Core</p>"
        },
